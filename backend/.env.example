# 服务器配置
PORT=3001
NODE_ENV=development
# CORS 白名单（逗号分隔；生产环境必须显式配置，未配置将拒绝所有跨源请求）
# 开发环境可留空（允许所有跨源），生产环境必须列出前端域名，例如：
# CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com
CORS_ORIGIN=

# MongoDB数据库
MONGODB_URI=mongodb://localhost:27017/travel_guide

# AI服务配置（默认使用 Agnes AI，OpenAI 兼容，免费额度）
# Agnes AI (https://platform.agnes-ai.com)
# API 网关：https://apihub.agnes-ai.com/v1
AGNES_API_KEY=your_agnes_api_key_here
AGNES_MODEL=agnes-2.0-flash
AI_PROVIDER=agnes

# 通义千问（阿里云）
TONGYI_API_KEY=your_tongyi_api_key_here

# 文心一言（百度）
WENXIN_API_KEY=your_wenxin_api_key_here
WENXIN_CLIENT_ID=your_wenxin_client_id_here
WENXIN_CLIENT_SECRET=your_wenxin_client_secret_here

# OpenAI GPT-4
OPENAI_API_KEY=your_openai_api_key_here
# AI_PROVIDER 可选值: agnes(默认), tongyi, wenxin, openai, zhipu, deepseek

# Firebase认证配置
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase Admin SDK（用于服务端）
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# JWT密钥（用于自定义token）
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# 高德地图API（可选）
AMAP_API_KEY=your_amap_api_key_here

# 和风天气API（v10.9.3：专属域名等价于凭证，建议迁移到环境变量）
# 若未配置，将回退到内置专属端点（保持现有部署兼容）
QWEATHER_API_URL=https://kp3h2rh7ab.re.qweatherapi.com/v7
QWEATHER_GEO_URL=https://kp3h2rh7ab.re.qweatherapi.com/v2